# Copy to .env.local and fill in. Never commit .env.local.
# Values for the local Supabase stack are printed by `npx supabase status` (run from the repo root).

# Public by design (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
