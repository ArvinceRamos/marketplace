# Copy to backend/.env and fill in. Never commit .env.
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:3100
SUPABASE_URL=http://127.0.0.1:54421
# Publishable key (public; `npx supabase status` shows the local one). Used for photo uploads.
SUPABASE_PUBLISHABLE_KEY=replace-me

# The api_app role (no RLS bypass). The local password comes from supabase/seed.sql
# and only works on your machine. Hosted projects use their own secret password.
DATABASE_URL=postgresql+asyncpg://api_app:replace-me@127.0.0.1:54422/postgres

# Secret key. Only use: deleting an Auth user during account deletion.
# Backend only, never the frontend. Local: `npx supabase status` (SECRET_KEY).
# Without it, DELETE /me answers 503 and nothing is removed.
SUPABASE_SECRET_KEY=replace-me

# Rate limits are in memory (reset on restart). Number of proxies in front of
# the API that append to X-Forwarded-For (Render: 1; local: 0).
TRUSTED_PROXY_HOPS=0

# Test-mode payments (docs/TRANSACTIONS_DESIGN.md). Everything is simulated.
# Signing secrets for the MockPay and MockCourier webhooks. Local/test have dev
# defaults; ENVIRONMENT=production refuses to start without real random values
# (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
MOCKPAY_WEBHOOK_SECRET=replace-me
MOCKCOURIER_WEBHOOK_SECRET=replace-me
# Demo buttons (simulate payment, advance tracking, skip ahead). Default: on,
# except in production, where you must set it to true to show them.
# DEMO_TOOLS_ENABLED=true
